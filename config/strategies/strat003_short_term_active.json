{
  "id": "STRAT-003",
  "name": "Short-Term Active Trading",
  "version": "3.0",
  "status": "VALIDATED-PAPER-READY",
  "created": "2025-01-11",
  "updated": "2025-01-23",
  "description": "Active trading strategy with LTH-SOPR exit trigger and Checkmate position sizing. Trades 9-15x/year with ~29 day holds.",

  "metadata": {
    "time_horizon": "SHORT-TERM",
    "trade_frequency": "9-15 trades/year",
    "avg_hold_period_days": 29,
    "complexity": "MEDIUM",
    "framework": "Weak hands entry + Smart money exit + Dynamic sizing",
    "research_notebooks": [
      "research/40_sth_sopr_only.ipynb",
      "research/43_adaptive_trail_strategy.ipynb",
      "research/44_realized_profit_exit.ipynb",
      "research/46_lth_sopr_exit.ipynb",
      "research/68_checkmate_with_our_strategies.ipynb",
      "research/69_strat003_checkmate_sizing.ipynb"
    ]
  },

  "entry": {
    "description": "STH-SOPR capitulation with Checkmate position sizing",
    "logic": "SIMPLE",
    "conditions": [
      {
        "id": "sth_sopr_capitulation",
        "metric": "sopr_sth",
        "operator": "<",
        "threshold": 1.0,
        "rationale": "Short-term holders selling at loss (weak hands capitulating)",
        "weight": 1
      }
    ],
    "timing": "first_day",
    "timing_description": "Enter on first day STH-SOPR < 1.0",
    "position_sizing": {
      "type": "dynamic",
      "method": "checkmate_composite",
      "description": "Size position based on Checkmate composite signal strength",
      "tiers": [
        {
          "signal_max": -1.0,
          "size_pct": 1.0,
          "description": "Very bullish - full allocation"
        },
        {
          "signal_max": -0.5,
          "size_pct": 0.8,
          "description": "Bullish - 80% allocation"
        },
        {
          "signal_max": 0.0,
          "size_pct": 0.6,
          "description": "Neutral bullish - 60% allocation"
        },
        {
          "signal_max": 0.5,
          "size_pct": 0.4,
          "description": "Weak - 40% allocation"
        },
        {
          "signal_max": 999,
          "size_pct": 0.25,
          "description": "Bearish - minimum 25% allocation"
        }
      ],
      "impact": "Improves Sharpe by +15.7% vs fixed sizing"
    }
  },

  "exit": {
    "description": "Adaptive trailing stop with LTH-SOPR trigger - Tightens when smart money distributes",
    "logic": "ADAPTIVE",
    "type": "adaptive_trailing_stop",
    "initial_trail_pct": 0.30,
    "triggered_trail_pct": 0.15,
    "trigger": {
      "logic": "AND",
      "conditions": [
        {
          "id": "mvrv_expensive",
          "metric": "mvrv",
          "operator": ">",
          "threshold": 2.5,
          "rationale": "Market is expensive relative to realized price"
        },
        {
          "id": "lth_sopr_distribution",
          "metric": "sopr_lth",
          "operator": ">",
          "threshold": 1.5,
          "rationale": "Long-term holders taking significant profits (smart money exiting)"
        }
      ],
      "description": "When BOTH MVRV>2.5 AND LTH-SOPR>1.5, tighten trail from 30% to 15%"
    },
    "timing": "any_day",
    "timing_description": "Trail active immediately at 30%, tightens to 15% when trigger fires",
    "innovation": "LTH-SOPR is 5x stronger signal than STH-SOPR at tops (~5.0 vs ~1.03)"
  },

  "checkmate_composite": {
    "description": "James Check's 6-metric composite for market regime scoring",
    "score_range": {
      "min": -2.0,
      "max": 2.0,
      "interpretation": "Negative = bullish, Positive = bearish"
    },
    "metrics": [
      {
        "metric": "mvrv",
        "weight": 0.30,
        "bullish_threshold": 1.0,
        "bearish_threshold": 2.4,
        "description": "Market value vs realized value"
      },
      {
        "metric": "mvrv_sth",
        "weight": 0.15,
        "bullish_threshold": 1.0,
        "bearish_threshold": 1.4,
        "description": "Short-term holder profitability"
      },
      {
        "metric": "mvrv_lth",
        "weight": 0.15,
        "bullish_threshold": 1.5,
        "bearish_threshold": 3.5,
        "description": "Long-term holder profitability"
      },
      {
        "metric": "nupl",
        "weight": 0.20,
        "bullish_threshold": 0.25,
        "bearish_threshold": 0.6,
        "description": "Net unrealized profit/loss"
      },
      {
        "metric": "sopr",
        "weight": 0.10,
        "bullish_threshold": 1.0,
        "bearish_threshold": 1.05,
        "description": "Spent output profit ratio"
      },
      {
        "metric": "aviv",
        "weight": 0.10,
        "bullish_threshold": 1.0,
        "bearish_threshold": 1.5,
        "description": "Active investor vs investor value"
      }
    ],
    "calculation": "Linear interpolation between bullish/bearish thresholds, weighted sum"
  },

  "risk_management": {
    "position_sizing": {
      "type": "dynamic",
      "method": "checkmate_composite",
      "min_size_pct": 0.25,
      "max_size_pct": 1.0,
      "description": "25-100% allocation based on market regime"
    },
    "stop_loss": {
      "enabled": false,
      "description": "Trailing stop handles all exits"
    },
    "max_positions": 1,
    "max_pyramid": false,
    "description": "Single position with dynamic sizing based on Checkmate signal"
  },

