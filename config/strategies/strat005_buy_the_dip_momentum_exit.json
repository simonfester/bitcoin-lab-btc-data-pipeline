{
  "id": "STRAT-005",
  "name": "Buy The Dip + Momentum-Confirmed Exit",
  "version": "1.0",
  "status": "VALIDATED-PAPER-READY",
  "created": "2025-01-22",
  "updated": "2025-01-23",
  "description": "James Check's Buy The Dip framework with momentum-confirmed exits. First strategy to beat Never Exit by 3.3x.",

  "metadata": {
    "time_horizon": "MEDIUM-TERM",
    "trade_frequency": "2-3 trades/year",
    "avg_hold_period_days": 125,
    "complexity": "MEDIUM",
    "framework": "James Check On-Chain Analysis",
    "research_notebooks": [
      "research/70_james_check_buy_the_dip.ipynb",
      "research/82_momentum_exit_filters.ipynb",
      "research/83_mvrv_momentum_deep_dive.ipynb",
      "research/84_entry_optimization.ipynb"
    ]
  },

  "entry": {
    "description": "Buy The Dip (4/5 conditions) - Wait for capitulation + derivatives reset",
    "logic": "COUNT_THRESHOLD",
    "required_conditions": 4,
    "total_conditions": 5,
    "conditions": [
      {
        "id": "sth_mvrv_underwater",
        "metric": "mvrv_sth",
        "operator": "<",
        "threshold": 1.0,
        "rationale": "Short-term holders are underwater (cost basis > price)",
        "weight": 1
      },
      {
        "id": "sth_sopr_capitulation",
        "metric": "sopr_sth",
        "operator": "<",
        "threshold": 1.0,
        "rationale": "Short-term holders actively selling at loss (capitulation)",
        "weight": 1
      },
      {
        "id": "realized_loss_dominance",
        "metric": "realized_pl_ratio",
        "operator": "<",
        "threshold": 1.0,
        "rationale": "Realized losses exceed realized profits",
        "weight": 1
      },
      {
        "id": "funding_reset",
        "metric": "funding_rate",
        "operator": "<=",
        "threshold": 0.0,
        "rationale": "Derivatives market bearish or neutral (no overheating)",
        "weight": 1
      },
      {
        "id": "long_liquidations",
        "metric": "liq_long",
        "operator": ">",
        "metric_compare": "liq_short",
        "rationale": "Long liquidations exceed shorts (forced selling complete)",
        "weight": 1
      }
    ],
    "timing": "first_day",
    "timing_description": "Enter on first day when threshold is met (4+ conditions true)",
    "alternative_entry": {
      "variant": "v2_3_of_5",
      "required_conditions": 3,
      "description": "More aggressive entry (3 of 5) generates more trades but lower win rate"
    }
  },

  "exit": {
    "description": "Momentum-confirmed valuation exit - Don't exit expensive markets until trend breaks",
    "logic": "AND",
    "conditions": [
      {
        "id": "mvrv_overvalued",
        "metric": "mvrv",
        "operator": ">",
        "threshold": 2.0,
        "rationale": "Market is overvalued relative to realized price"
      },
      {
        "id": "momentum_broken",
        "metric": "price",
        "operator": "<",
        "metric_compare": "price_ma_50",
        "rationale": "Price breaks below 50-day MA (trend reversal confirmed)"
      }
    ],
    "timing": "first_day",
    "timing_description": "Exit on first day when BOTH conditions are true",
    "innovation": "Combines valuation (MVRV) with momentum (MA) to avoid premature exits during sustained bull runs"
  },

  "risk_management": {
    "position_sizing": {
      "type": "fixed",
      "size_pct": 1.0,
      "description": "100% allocation per signal (tested without leverage)"
    },
    "stop_loss": {
      "enabled": false,
      "description": "No stop loss - strategy already has excellent win rate (93.8%)"
    },
    "max_positions": 1,
    "max_pyramid": false,
    "description": "Single position, full allocation, no pyramiding"
  },

  "data_requirements": {
