  "entry": {
    "description": "All 5 indicators must fire simultaneously - Rare signal (6% of time) = High quality",
    "logic": "AND",
    "required_conditions": 5,
    "total_conditions": 5,
    "conditions": [
      {
        "id": "sth_mvrv_underwater",
        "metric": "mvrv_sth",
        "operator": "<",
        "threshold": 1.0,
        "rationale": "Short-term holders underwater (cost basis > price)",
        "weight": 1
      },
      {
        "id": "sth_sopr_capitulation",
        "metric": "sopr_sth",
        "operator": "<",
        "threshold": 1.0,
        "rationale": "Short-term holders selling at loss (weak hands panic)",
        "weight": 1
      },
      {
        "id": "realized_loss_dominance",
        "metric": "realized_pl_ratio",
        "operator": "<",
        "threshold": 1.0,
        "rationale": "Realized losses exceed profits (capitulation intensity)",
        "weight": 1
      },
      {
        "id": "funding_reset",
        "metric": "funding_rate",
        "operator": "<=",
        "threshold": 0.0,
        "rationale": "Funding rate bearish/neutral (derivatives not overheated)",
        "weight": 1
      },
      {
        "id": "long_liquidations",
        "metric": "liq_long",
        "operator": ">",
        "metric_compare": "liq_short",
        "rationale": "Long liquidations exceed shorts (forced selling complete)",
        "weight": 1
      }
    ],
    "timing": "first_day",
    "timing_description": "Enter on first day ALL 5 conditions are true simultaneously",
    "alternative_entry": {
      "variant": "4_of_5",
      "required_conditions": 4,
      "description": "More signals with similar quality (tested in STRAT-005)",
      "forward_return_30d": 7.4,
      "win_rate_pct": 75
    },
    "signal_rarity": {
      "pct_of_time": 6,
      "description": "Signal fires 6% of time = Quality over quantity"
    }
  },

  "exit": {
    "description": "10% trailing stop - Let winners run, cut losers quickly",
    "logic": "SIMPLE",
    "type": "trailing_stop_with_initial_stop",
    "initial_stop_loss_pct": -0.15,
    "trailing_stop_pct": 0.10,
    "conditions": [
      {
        "id": "initial_stop",
        "metric": "price",
        "operator": "<",
        "metric_compare": "entry_price",
        "threshold_pct": -0.15,
        "rationale": "Stop loss 15% below entry (activated immediately)",
        "active_when": "not_yet_profitable"
      },
      {
        "id": "trailing_stop",
        "metric": "price",
        "operator": "<",
        "metric_compare": "peak_price",
        "threshold_pct": -0.10,
        "rationale": "Trail 10% below highest price once profitable",
        "active_when": "profitable"
      }
    ],
    "timing": "any_day",
    "timing_description": "Exit when initial stop or trailing stop triggered",
    "innovation": "10% trail vastly outperforms fixed hold periods and signal exits",
    "alternative_exits": {
      "30d_fixed_hold_15_stop": {
        "description": "Exit after 30 days or -15% stop loss",
        "result_in_sample": "-46.6% return",
        "result_out_sample": "+56.8% return",
        "rejected_reason": "Underperforms trailing stop significantly"
      },
      "signal_exit": {
        "description": "Exit when any condition turns false",
        "result_in_sample": "+188.9% return",
        "result_out_sample": "+6.8% return",
        "avg_hold_days": 1,
        "rejected_reason": "Captures bounce but misses rally - too short"
      }
    }
  },

