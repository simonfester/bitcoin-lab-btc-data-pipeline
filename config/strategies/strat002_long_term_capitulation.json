  "entry": {
    "description": "Triple capitulation signal - SOPR + STH-SOPR + Realized Loss intensity",
    "logic": "AND",
    "conditions": [
      {
        "id": "sopr_loss_selling",
        "metric": "sopr",
        "operator": "<",
        "threshold": 1.0,
        "rationale": "Overall market selling at loss (cost basis > price)",
        "weight": 1
      },
      {
        "id": "sth_sopr_capitulation",
        "metric": "sopr_sth",
        "operator": "<",
        "threshold": 1.0,
        "rationale": "Short-term holders also selling at loss (weak hands panic)",
        "weight": 1
      },
      {
        "id": "realized_loss_intensity",
        "metric": "realized_loss_z",
        "operator": ">",
        "threshold": 0.5,
        "rationale": "Above-average loss-taking (capitulation intensity confirmed)",
        "weight": 1
      }
    ],
    "timing": "first_day",
    "timing_description": "Enter on first day when ALL 3 conditions are true (not continuation days)",
    "historical_catch_rate": "100% of major bottoms caught (2019-2026)"
  },

  "exit": {
    "description": "Simple 30% trailing stop - ALWAYS active. No MVRV trigger, no stop loss, no time limit.",
    "logic": "SIMPLE",
    "type": "trailing_stop",
    "trailing_stop_pct": 0.30,
    "conditions": [
      {
        "id": "trail_stop_hit",
        "metric": "price",
        "operator": "<",
        "metric_compare": "peak_price",
        "threshold_pct": -0.30,
        "rationale": "Price drops 30% from highest price reached during trade"
      }
    ],
    "timing": "any_day",
    "timing_description": "Exit when price drops 30% from peak (trail is active immediately)",
